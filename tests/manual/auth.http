
@endpoint = http://localhost:3010/api/v1

POST {{endpoint}}/auth/register HTTP/1.1
content-type: application/json

{
    "name": "fdf",
    "email": "una3@example.com",
    "password": "pasadfdfdfsdf",
    "role": "admin"
}

###

# @name login
POST {{endpoint}}/auth/login HTTP/1.1
content-type: application/json


{
    "email": "una2@example.com",
    "password": "pasadfdfdfsdf"
}
###

@accessToken = {{login.response.body.token}}

DELETE {{endpoint}}/cars/6ab39cadb621c21094773d27 HTTP/1.1
content-type: application/json
Authorization: Bearer {{accessToken}}
 
###
 
GET {{endpoint}}/auth/me HTTP/1.1
Authorization: Bearer {{accessToken}}

###
# @name getallusers
GET {{endpoint}}/auth/users HTTP/1.1
Authorization: Bearer {{accessToken}}


