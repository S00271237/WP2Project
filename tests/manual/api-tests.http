@endpoint = http://localhost:3010/api/v1
@apiKey = test

@email = {{register.request.body.$.email}}
@password = {{register.request.body.$.password}}
@userId = {{register.response.body._id}}
@accessToken = {{login.response.body.token}}
@anglerId = {{createAngler.response.body._id}}
@sessionId = {{addSession.response.body.$.sessions[0]._id}}
@catchId = {{addCatch.response.body.$.sessions[0].catches[0]._id}}


# auth

### register a new user (timestamp keeps the email unique on every run)
# @name register
POST {{endpoint}}/auth/register HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "name": "Dave",
  "email": "dave1@example.com",
  "password": "SecurePassword123"
}

### register the same email again (expect 409)
POST {{endpoint}}/auth/register HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "name": "Dave",
  "email": "{{email}}",
  "password": "SecurePassword123"
}

### invalid email (expect 400)
POST {{endpoint}}/auth/register HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "name": "Dave",
  "email": "not-an-email",
  "password": "SecurePassword123"
}

### password too short (expect 400)
POST {{endpoint}}/auth/register HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "name": "Dave",
  "email": "short@example.com",
  "password": "abc"
}

### missing password (expect 400)
POST {{endpoint}}/auth/register HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "name": "Dave",
  "email": "nopass@example.com"
}

### missing name (expect 400)
POST {{endpoint}}/auth/register HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "email": "noname@example.com",
  "password": "SecurePassword123"
}


# AUTH: login

### log in as the user registered above
# @name login
POST {{endpoint}}/auth/login HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### wrong password (expect 401)
POST {{endpoint}}/auth/login HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "email": "{{email}}",
  "password": "WrongPassword"
}

### email that does not exist (expect 401)
POST {{endpoint}}/auth/login HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "email": "nobody@example.com",
  "password": "SecurePassword123"
}


# AUTH: protected routes

### who am I
GET {{endpoint}}/auth/me HTTP/1.1
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}

### get all users
GET {{endpoint}}/auth/users HTTP/1.1
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}

### no token (expect 401)
GET {{endpoint}}/auth/me HTTP/1.1
x-api-key: {{apiKey}}

### bad token (expect 401)
GET {{endpoint}}/auth/me HTTP/1.1
x-api-key: {{apiKey}}
Authorization: Bearer not.a.real.token


# ANGLERS

### create an angler linked to the registered user
# @name createAngler
POST {{endpoint}}/anglers HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "user": "{{userId}}",
  "name": "Una"
}

### a second angler for the same user
POST {{endpoint}}/anglers HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "user": "{{userId}}",
  "name": "Dave Again"
}

### name too short (expect 400)
POST {{endpoint}}/anglers HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "user": "{{userId}}",
  "name": "D"
}

### missing name (expect 400)
POST {{endpoint}}/anglers HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "user": "{{userId}}"
}

### invalid user id (expect 400)
POST {{endpoint}}/anglers HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "user": "not-an-id",
  "name": "Dave"
}

### get all anglers
GET {{endpoint}}/anglers HTTP/1.1
x-api-key: {{apiKey}}

### get one angler
GET {{endpoint}}/anglers/{{anglerId}} HTTP/1.1
x-api-key: {{apiKey}}

### invalid angler id format (expect 400)
GET {{endpoint}}/anglers/sillyAnglerID HTTP/1.1
x-api-key: {{apiKey}}

### valid id format but no such angler (expect 404)
GET {{endpoint}}/anglers/000000000000000000000000 HTTP/1.1
x-api-key: {{apiKey}}

### update the angler's name
PUT {{endpoint}}/anglers/{{anglerId}} HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "name": "James"
}

### name too long (expect 400)
PUT {{endpoint}}/anglers/{{anglerId}} HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "name": "This name is far too long to be accepted by the validation rules set up"
}


# SESSIONS

### add a session
# @name addSession
POST {{endpoint}}/anglers/{{anglerId}}/sessions HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "location": {
    "area": "Lough Key",
    "waterBody": "Lake"
  },
  "startTime": "2026-10-04T07:30:00.000Z"
}

### no location (expect 400)
POST {{endpoint}}/anglers/{{anglerId}}/sessions HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "startTime": "2026-10-04T07:30:00.000Z"
}

### no start time (expect 400)
POST {{endpoint}}/anglers/{{anglerId}}/sessions HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "location": {
    "area": "Lough Key",
    "waterBody": "Lake"
  }
}

### angler that does not exist (expect 404)
POST {{endpoint}}/anglers/000000000000000000000000/sessions HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "location": {
    "area": "Lough Key",
    "waterBody": "Lake"
  },
  "startTime": "2026-10-04T07:30:00.000Z"
}

### set the end time
PUT {{endpoint}}/anglers/{{anglerId}}/sessions/{{sessionId}} HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "endTime": "2026-10-04T12:15:00.000Z"
}

### end time before the start time (expect 400)
PUT {{endpoint}}/anglers/{{anglerId}}/sessions/{{sessionId}} HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "endTime": "2026-10-04T06:00:00.000Z"
}

### change the location
PUT {{endpoint}}/anglers/{{anglerId}}/sessions/{{sessionId}} HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "location": {
    "area": "River Shannon, Carrick",
    "waterBody": "River"
  }
}

### session that does not exist (expect 404)
PUT {{endpoint}}/anglers/{{anglerId}}/sessions/000000000000000000000000 HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "endTime": "2026-10-04T12:15:00.000Z"
}


# CATCHES

### add a catch
# @name addCatch
POST {{endpoint}}/anglers/{{anglerId}}/sessions/{{sessionId}}/catches HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "species": "Pike",
  "quantity": 1,
  "sizeCm": 68,
  "bait": "Spinner"
}

### only the species
POST {{endpoint}}/anglers/{{anglerId}}/sessions/{{sessionId}}/catches HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "species": "Perch"
}

### no species (expect 400)
POST {{endpoint}}/anglers/{{anglerId}}/sessions/{{sessionId}}/catches HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "quantity": 2,
  "sizeCm": 30
}

### negative size (expect 400)
POST {{endpoint}}/anglers/{{anglerId}}/sessions/{{sessionId}}/catches HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "species": "Pike",
  "sizeCm": -5
}

### session that does not exist (expect 404)
POST {{endpoint}}/anglers/{{anglerId}}/sessions/000000000000000000000000/catches HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "species": "Pike"
}

### correct the size of the first catch
PUT {{endpoint}}/anglers/{{anglerId}}/sessions/{{sessionId}}/catches/{{catchId}} HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "sizeCm": 72
}

### catch that does not exist (expect 404)
PUT {{endpoint}}/anglers/{{anglerId}}/sessions/{{sessionId}}/catches/000000000000000000000000 HTTP/1.1
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "sizeCm": 72
}

### delete the first catch
DELETE {{endpoint}}/anglers/{{anglerId}}/sessions/{{sessionId}}/catches/{{catchId}} HTTP/1.1
x-api-key: {{apiKey}}

### delete the same catch again (expect 404)
DELETE {{endpoint}}/anglers/{{anglerId}}/sessions/{{sessionId}}/catches/{{catchId}} HTTP/1.1
x-api-key: {{apiKey}}


# CLEAN UP

### delete the session
DELETE {{endpoint}}/anglers/{{anglerId}}/sessions/{{sessionId}} HTTP/1.1
x-api-key: {{apiKey}}

### delete the angler with no api key (expect 401)
DELETE {{endpoint}}/anglers/{{anglerId}} HTTP/1.1

### delete the angler
DELETE {{endpoint}}/anglers/{{anglerId}} HTTP/1.1
x-api-key: {{apiKey}}
