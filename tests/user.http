@endpointAngler = http://localhost:3010/api/v1/anglers
@endpointUser = http://localhost:3010/api/v1/users

###
# Get all anglers
GET {{endpointAngler}} HTTP/1.1
Content-Type: application/json
x-api-key: test

###
POST {{endpointAngler}} HTTP/1.1
Content-Type: application/json
x-api-key: test

{
  "name": "Dave",
}
###
POST {{endpointUser}} HTTP/1.1
Content-Type: application/json
x-api-key: test

{
  "name": "John Doe",
  "email": "john.doe@example.com",
  "password": "SecurePassword123"
}
